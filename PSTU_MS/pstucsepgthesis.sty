        \textbf{Supervisor}
      \end{tabular}%
      \hfill
      \begin{tabular}{@{}c@{}}
        \rule{4.5cm}{0.4pt}\\[0.2em]
        \DTLforeach{CoSupervisor}{\CoSupName=Column1,\CoSupDesig=Column2}{{\large \CoSupName}\\[0.1em] \CoSupDesig}\\[0.1em]
        \textbf{Co-Supervisor}
      \end{tabular}%
    }%
    \vspace{1.0em}

    % ---------- Chairman – perfectly centered ----------
    \makebox[\textwidth][c]{%
      \begin{tabular}{@{}c@{}}
        \rule{5cm}{0.4pt}\\[0.2em]
        \DTLforeach{Chairman}{\ChairName=Column1,\ChairDesig=Column2}{{\large \ChairName}\\[0.1em] \ChairDesig}\\[0.1em]
        \textbf{Chairman, Defense Committee}\\[0.1em]
        and\\[0.1em]
        \textbf{Chairman, Department of CSIT}\\
      \end{tabular}%
    }%
    \end{singlespace}

    \vfill
    \thesisdate\par
  \endgroup
}




