% Thesis title page 
\def\thesistitlepage{
  \thispagestyle{empty}
  \begingroup
  \centering
    % ---------- Title ----------
    \textbf{{\LARGE\begin{spacing}{1.2}\thesistitle\end{spacing}}}
    \vfill

    % ---------- “A Thesis” ----------
    {\large A Thesis\par}
    \vfill

    % ---------- Submitted to … ----------
    \begin{spacing}{1.0}
    {\large
      Submitted to\\
      Patuakhali Science and Technology University, Patuakhali\\
      In Partial Fulfillment of the Requirements\\
      for the Degree of Master of Science\\
      in\\
      Computer Science and Information Technology\par
    }
    \end{spacing}
    \vfill

    % ---------- Student Info ----------
    {\large By\par}
    \DTLforeach{ThesisStudents}{\StudentName=Column1,\StudentRoll=Column2,\StudentReg=Column3}{%
      {\large\bfseries \StudentName}\\[0.3em]
      {\large Roll/ID No: \StudentRoll}\\[0.3em]
      {\large Registration No: \StudentReg}
    }

    \vfill
    \includegraphics[width=35mm]{figures/LogoPSTU.png}\\
    \textbf{\cse}\\
    \textbf{\large\pstu}\\
    \smallskip
    Patuakhali, Bangladesh\\
    \medskip
    \thesisdate\par
  \endgroup
}


% Thesis approval page page 

% -------------------------------------------------
%  Approval page – pixel-perfect match to specimen
