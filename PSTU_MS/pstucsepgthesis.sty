\def\thesisapprovalpage{%
  \thispagestyle{empty}
  \vspace*{\fill}                     % start from top, push content down

  \begingroup
  \centering
    % ---------- Title (1.2 spaced) ----------
    {\LARGE\bfseries\begin{spacing}{1.2}\thesistitle\end{spacing}\par}
    \vfill

    % ---------- “A Thesis” ----------
    {\large A Thesis\par}
    \vfill
    % ---------- Submitted to … (with dotted lines) ----------
    \begin{spacing}{1.0}
    {\large
      Submitted to\\
      Patuakhali Science and Technology University, Patuakhali\\
      In Partial Fulfillment of the Requirements\\
      for the Degree of Master of Science\\
      in\\
      Computer Science and Information Technology\par
    }
    \end{spacing}
    \vfill

    % ---------- Approved as to style … ----------
    {\large Approved as to style and contents by:}\par
    \vspace{1.5em}
 % Spacing before signature lines (needed for visual clarity)

    \begin{singlespace}
    % ---------- Supervisor / Co-Supervisor (side-by-side) ----------
    \makebox[\textwidth][c]{%
      \begin{tabular}{@{}c@{}}
        \rule{4.5cm}{0.4pt}\\[0.2em]
